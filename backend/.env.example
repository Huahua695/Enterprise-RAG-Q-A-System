# 数据库配置
DATABASE_URL=sqlite:///./db_data/main.db
# 如需 PostgreSQL：DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rag_knowledge_base

# JWT 配置（生产环境务必更换）
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Agnes AI API 配置（请填入你自己的 Key）
AGNES_API_KEY=sk-your-agnes-api-key-here
AGNES_BASE_URL=https://apihub.agnes-ai.com/v1
AGNES_MODEL=agnes-2.0-flash
AGNES_EMBEDDING_MODEL=text-embedding-3-small

# 向量库配置（FAISS 本地持久化目录）
VECTOR_STORE_DIR=./db_data/vector_db

# 文件上传配置
UPLOAD_DIR=./db_data/uploads
MAX_UPLOAD_SIZE=10MB

# Redis 配置（可选）
REDIS_URL=redis://localhost:6379/0

# 前端 CORS 配置
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
