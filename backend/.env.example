# 数据库配置
DATABASE_URL=sqlite:///./db_data/main.db
# 如需 PostgreSQL：DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rag_knowledge_base

# JWT 签名密钥（必填，留空服务会拒绝启动）
# 生成方式：python -c "import secrets; print(secrets.token_hex(32))"
# 切勿沿用模板里的示例值，也不要写回源码
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# 登录限流（连续失败 N 次后封禁一个窗口时长；单进程内存实现）
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15

# LLM API 配置（任意 OpenAI 兼容接口，问答功能依赖，请填入你自己的 Key）
LLM_API_KEY=sk-your-api-key-here
# LLM_BASE_URL 留空走 OpenAI 官方接口；第三方网关一般填到 /v1 一级，例如：
#   DeepSeek:   https://api.deepseek.com/v1                          （模型 deepseek-chat）
#   通义千问:    https://dashscope.aliyuncs.com/compatible-mode/v1    （模型 qwen-plus）
#   Ollama 本地: http://localhost:11434/v1                            （无需鉴权时 LLM_API_KEY 可填任意占位值）
#   LM Studio:   http://localhost:1234/v1                             （模型名填已加载模型的标识符，可用 curl http://localhost:1234/v1/models 查询）
# LLM_MODEL=deepseek-chat
# 请求超时与重试（秒 / 次数）：避免网络异常时流式回答永久挂起，本地小模型可调大
# LLM_TIMEOUT=60
# LLM_MAX_RETRIES=2

# 向量库配置（FAISS 本地持久化目录）
VECTOR_STORE_DIR=./db_data/vector_db

# Embedding 配置（fastembed=真实语义模型默认；local=零依赖哈希；openai=任意 OpenAI 兼容接口。
# 切换 provider/模型后必须重建向量索引！）
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
# EMBEDDING_CACHE_DIR=./db_data/models   # 模型缓存目录（首次运行自动下载约 90MB）
# EMBEDDING_DIM=1024                     # 仅 local 哈希方案使用

# 日志配置（输出到 db_data/logs/app.log，滚动保留 3 个 5MB 文件）
LOG_LEVEL=INFO
LOG_DIR=./db_data/logs

# 文件上传配置
UPLOAD_DIR=./db_data/uploads
MAX_UPLOAD_SIZE=10MB
ALLOWED_UPLOAD_TYPES=pdf,docx,txt,md,markdown,xlsx,xls

# Redis 配置（可选）
REDIS_URL=redis://localhost:6379/0

# 前端 CORS 配置
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
