# Docker Compose 部署配置模板：复制为项目根目录 .env 并填写
# （cp .env.example .env；该文件已被 .gitignore 排除）

# 必填：JWT 签名密钥，生成方式 python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# 问答功能依赖（Agnes API Key）
AGNES_API_KEY=
# AGNES_BASE_URL=https://apihub.agnes-ai.com/v1
# AGNES_MODEL=agnes-2.0-flash

# Embedding（默认 fastembed 语义模型；模型缓存在容器 /app/db_data/models，随卷持久化）
# EMBEDDING_PROVIDER=fastembed
# HF_ENDPOINT=https://hf-mirror.com
# HF_HUB_DISABLE_XET=1

# 日志级别（DEBUG / INFO / WARNING / ERROR）
# LOG_LEVEL=INFO

# 前端访问地址（CORS 白名单，经 nginx 反代访问时用不到，直连 8000 端口时需要）
# ALLOWED_ORIGINS=http://localhost:8080
